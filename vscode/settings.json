{
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "relative",
  "workbench.activityBar.orientation": "vertical",
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "editor.cursorSurroundingLines": 8,
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "#a9dc7660",
  "vim.highlightedyank.duration": 200,
  "vim.useSystemClipboard": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    // File Tree
    {
      "before": [
        "<leader>",
        "e",
      ],
      "commands": [
        "workbench.view.explorer"
      ]
    },
    // Buffer Navigation
    {
      "before": [
        "<S-h>"
      ],
      "commands": [
        ":bprevious"
      ]
    },
    {
      "before": [
        "<S-l>"
      ],
      "commands": [
        ":bnext"
      ]
    },
    // Semantic File Navigation
    {
      "before": [
        "[",
        "d"
      ],
      "commands": [
        "editor.action.marker.prev"
      ]
    },
    {
      "before": [
        "]",
        "d"
      ],
      "commands": [
        "editor.action.marker.next"
      ]
    },
    {
      "before": [
        "]",
        "x"
      ],
      "commands": [
        "merge-conflict.next"
      ]
    },
    {
      "before": [
        "[",
        "x",
      ],
      "commands": [
        "merge-conflict.previous"
      ]
    },
    {
      "before": [
        "]",
        "h"
      ],
      "commands": [
        "workbench.action.editor.nextChange"
      ]
    },
    {
      "before": [
        "[",
        "h"
      ],
      "commands": [
        "workbench.action.editor.previousChange"
      ]
    },
    {
      "before": [
        "]",
        "]"
      ],
      "commands": [
        "editor.action.wordHighlight.next"
      ],
    },
    {
      "before": [
        "[",
        "["
      ],
      "commands": [
        "editor.action.wordHighlight.prev"
      ],
    },
    // Code Actions
    {
      "before": [
        "<leader>",
        "c",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "u"
      ],
      "commands": [
        {
          "command": "editor.action.sourceAction",
          "args": {
            "kind": "source.addMissingImports",
            "apply": "first"
          }
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "s"
      ],
      "commands": [
        "editor.action.sourceAction",
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "r"
      ],
      "commands": [
        "editor.action.rename",
      ]
    },
    // Fuzzy Finders
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "commands": [
        "workbench.action.showCommands"
      ]
    },
    {
      "before": [
        "<leader>",
        ","
      ],
      "commands": [
        "workbench.action.showAllEditors"
      ]
    },
    {
      "before": [
        "K",
      ],
      "commands": [
        "editor.action.showDefinitionPreviewHover"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "g"
      ],
      "commands": [
        "workbench.action.togglePanel"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "o"
      ],
      "commands": [
        "gitlens.openFileOnRemoteFrom"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "y"
      ],
      "commands": [
        "gitlens.copyRemoteFileUrlFrom"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "h",
        "r"
      ],
      "commands": [
        "git.revertSelectedRanges"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "p"
      ],
      "commands": [
        "editor.action.dirtydiff.next"
      ]
    },
    {
      "before": [
        "<leader>",
        "/"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "g",
        "I"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ]
    },
    {
      "before": [
        "g",
        "p",
        "i"
      ],
      "commands": [
        "editor.action.peekImplementation"
      ]
    },
    {
      "before": [
        "g",
        "q"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.referenceSearch.trigger"
      ]
    },
    {
      "before": [
        "g",
        "t"
      ],
      "commands": [
        "editor.action.goToTypeDefinition"
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.view.explorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "d"
      ],
      "commands": [
        "workbench.action.closeEditorsAndGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "|"
      ],
      "commands": [
        "workbench.action.splitEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "-"
      ],
      "commands": [
        "workbench.action.splitEditorDown"
      ]
    },
    {
      "before": [
        "<S-h>"
      ],
      "commands": [
        "workbench.action.previousEditor"
      ]
    },
    {
      "before": [
        "<S-l>"
      ],
      "commands": [
        "workbench.action.nextEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "P"
      ],
      "commands": [
        "workbench.action.closeUnmodifiedEditors"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "p"
      ],
      "commands": [
        {
          "command": "workbench.action.pinEditor",
          "when": "!activeEditorIsPinned"
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "u"
      ],
      "commands": [
        {
          "command": "workbench.action.unpinEditor",
          "when": "activeEditorIsPinned"
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "r"
      ],
      "commands": [
        "workbench.action.closeEditorsToTheRight"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "l"
      ],
      "commands": [
        "workbench.action.closeEditorsToTheLeft"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "b"
      ],
      "commands": [
        "workbench.action.reopenClosedEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "d"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "o"
      ],
      "commands": [
        "workbench.action.closeOtherEditors"
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    // Fuzzy Finders
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "commands": [
        "workbench.action.showCommands"
      ]
    },
    {
      "before": [
        "<leader>",
        ","
      ],
      "commands": [
        "workbench.action.showAllEditors"
      ]
    },
    {
      "before": [
        "<leader>",
        "/"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "o"
      ],
      "commands": [
        "gitlens.openFileOnRemote"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "y"
      ],
      "commands": [
        "gitlens.copyRemoteFileUrlFrom"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "h",
        "r"
      ],
      "commands": [
        "git.revertSelectedRanges"
      ]
    },
    // Editor Actions
    {
      "before": [
        "<"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    },
    {
      "before": [
        ">"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "J"
      ],
      "commands": [
        "editor.action.moveLinesDownAction"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.moveLinesUpAction"
      ]
    },
  ],
  "editor.accessibilitySupport": "off",
  "editor.smoothScrolling": true,
  "vim.sneak": true,
  "vsicons.dontShowNewVersionMessage": true,
  "vim.smartRelativeLine": true,
  "vim.sneakReplacesF": true,
  "vim.scroll": 0,
  "workbench.editor.wrapTabs": true,
  "antlr4.generation": {
    "mode": "internal",
    "listeners": true,
    "visitors": false
  },
  "gitlens.hovers.currentLine.over": "line",
  "workbench.activityBar.location": "hidden",
  "window.density.editorTabHeight": "compact",
  "window.commandCenter": false,
  "window.title": "${rootName}${separator}${activeRepositoryBranchName}${separator}${profileName}",
  "search.mode": "newEditor",
  "editor.fontSize": 14,
  "terminal.integrated.fontSize": 14,
  "cursor.cpp.enablePartialAccepts": true,
  "go.toolsManagement.autoUpdate": true,
  "workbench.colorTheme": "Dark Modern (OLED Black)",
}
