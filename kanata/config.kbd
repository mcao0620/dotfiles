;; Kanata configuration 

(defcfg
  process-unmapped-keys yes
)

;; Define the physical key layout (defsrc)
;; Based on the standard Mac keyboard layout.
;; We are only overriding the bottom 5 rows (including spacebar row).
;;
;; Adjust the key names below to match your actual hardware if needed.

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet spc  rmet ralt
)

(defoverrides
  ;; Shift+, -> _
  (rsft ,) (rsft -)

  ;; Shift+. -> -
  (rsft .) (-)
)

;; Layer 0: Base layer
;; Transforms Mac laptop layout into a split keyboard layout, shifted up one row
;; - Uses number row for QWERTY top row (q-p)
;; - Uses tab row for QWERTY home row (a-;) with quote
;; - Uses caps row for QWERTY bottom row (z-.)
(deflayer base
  ;; Row 0 (13 keys): Function row mapped to media keys
  ;;      brdn brup XX   XX   XX   XX   prev pp   next mute vold volu
  esc     brdn brup XX   XX   XX   XX   prev pp   next mute vold volu
  ;; Row 1 (14 keys): QWERTY top row on number row - DROP(grv) + LEFT(5) + GAP(2) + RIGHT(5) + DROP(bspc)
  XX   q    w    e    r    t    XX   XX   y    u    i    o    p    XX
  
  ;; Row 2 (14 keys): QWERTY home row on tab row - Ctrl/Esc + LEFT(5) + GAP(2) + RIGHT(6 with quote)
  (tap-hold-press 200 200 esc lctl)   a    s    d    f    g    XX   XX   h    j    k    l    ;    '
  
  ;; Row 3 (13 keys): QWERTY bottom row on caps row - DROP(caps) + LEFT(5) + GAP(2) + RIGHT(4) + slash
  XX   z    x    c    v    b    XX   XX   n    m    ,    .    /
  
  ;; Row 4 (12 keys): Thumb cluster moved here - c/v positions (left) and m/comma positions (right)
  ;;                   3 XX + 2 thumb(left) + 2 gap + 2 thumb(right) + 3 XX
  XX   XX   XX   (tap-hold-press 200 10000 tab (layer-toggle numbers)) spc  XX   XX   rsft (tap-hold-press 200 10000 ret (layer-toggle symbols)) XX   XX   XX
  
  ;; Row 5 (6 keys): All cleared - thumb cluster moved to row 4
  XX   XX   XX   XX   XX   XX
)

;; Layer 1: Numbers and navigation
;; Activated when left thumb key (tab) is held
(deflayer numbers
  ;; Row 0 (13 keys): Function row transparent
  _    _    _    _    _    _    _    _    _    _    _    _    _
  ;; Row 1 (14 keys): Numbers 1-0 with - and =
  XX   1    2    3    4    5    XX   XX   6    7    8    9    0    -
  
  ;; Row 2 (14 keys): Home row mods on left, arrows + backspace on right
  (tap-hold-press 200 200 esc lctl)  lsft lalt lctl lmet XX   XX   XX   left down up   rght bspc XX
  
  ;; Row 3 (13 keys): All blocked/unused
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  
  ;; Row 4 (12 keys): Keep layer active while held
  XX   XX   XX   _    _    XX   XX   rsft XX   XX   XX   XX
  
  ;; Row 5 (6 keys): All cleared
  XX   XX   XX   XX   XX   XX
)

;; Layer 2: Symbols
;; Activated when right thumb key (ret) is held
(deflayer symbols
  ;; Row 0 (13 keys): Function row transparent
  _    _    _    _    _    _    _    _    _    _    _    _    _
  ;; Row 1 (14 keys): Symbols ! < > $ % ^ & * ( )
  XX   S-\  S-,  S-.  S-4  S-5  XX   XX   S-6  S-7  S-8  S-9  S-0  XX
  
  ;; Row 2 (14 keys): Left symbols and right modifiers with grave at end
  ;;                   !    -    +    =                 right mods    grv
  (tap-hold-press 200 200 esc lctl)  S-1  -    S-=  =    S-3   XX   XX   XX   rmet rctl lalt lsft grv
  
  ;; Row 3 (13 keys): Shift + symbols / * \ ~ and brackets [ { } ] |
  lsft XX   /    S-8  \    S-grv XX  XX   XX [    S-[  S-]  ]
  
  ;; Row 4 (12 keys): Keep layer active while held
  XX   XX   XX   XX   _    XX   XX   _    _    XX   XX   XX
  
  ;; Row 5 (6 keys): All cleared
  XX   XX   XX   XX   XX   XX
)
